#!/usr/bin/env bash
# Запуск одного приложения через прокси или VPN-ключ (sing-box HTTP/SOCKS5 + proxychains4).
# Если активен другой VPN, который блокирует трафик мимо своего туннеля и удаляет
# чужие маршруты, соединение с сервером идёт через него (содержимое зашифровано).
#
# Использование:
#   sing <команда> [аргументы]   — запустить команду через прокси
#   sing app <Имя.app>           — GUI/Electron-приложение (Claude, Slack, Chrome…)
#   sing stop                    — остановить sing-box
#   sing status                  — показать состояние
#   sing select                  — список серверов (подписка + свои), * — текущий
#   sing select <имя>            — переключиться на сервер (sing-box перезапустится)
#   sing select add <ссылка> [имя] — добавить свой прокси (vless/vmess/trojan/ss/hy2/wg/socks5/http)
#   sing select add <файл.conf> [имя] — импортировать конфиг WireGuard
#   sing select add socks5 1.2.3.4:1080 логин пароль [имя] — то же в формате «протокол айпи:порт»
#   sing select add socks5://1.2.3.4:1080:логин:пароль [имя]
#   sing select rm <имя>         — удалить свой прокси
set -euo pipefail

SING_BOX_CONFIG="$HOME/.config/sing-box/sing.json"
PROXYCHAINS_CONFIG="$HOME/.proxychains/sing.conf"
SOCKS_PORT=1080
PID_FILE="$HOME/.config/sing-box/sing.pid"
LOG_FILE="$HOME/Library/Logs/sing.log"
SELECT_SCRIPT="$HOME/.local/share/sing/select.py"

# Достаёт адрес сервера из конфига sing-box (plutil умеет читать JSON).
# WireGuard лежит в endpoints, остальные протоколы — в outbounds.
get_server_host() {
  plutil -extract outbounds.0.server raw -o - "$SING_BOX_CONFIG" 2>/dev/null \
    || plutil -extract endpoints.0.peers.0.address raw -o - "$SING_BOX_CONFIG"
}

# Резолвит хост в IPv4; если уже IP — возвращает как есть.
resolve_ipv4() {
  local host="$1"
  if [[ "$host" =~ ^[0-9]+(\.[0-9]+){3}$ ]]; then
    echo "$host"
  else
    dscacheutil -q host -a name "$host" | awk '/^ip_address:/ { print $2; exit }'
  fi
}

# Проверяет, слушает ли кто-то локальный SOCKS-порт.
is_socks_listening() {
  nc -z 127.0.0.1 "$SOCKS_PORT" >/dev/null 2>&1
}

# Поднимает sing-box в фоне, если он ещё не запущен, и ждёт открытия порта.
ensure_sing_box_running() {
  if is_socks_listening; then
    return
  fi
  nohup sing-box run -c "$SING_BOX_CONFIG" >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  for _attempt in $(seq 1 50); do
    is_socks_listening && return
    sleep 0.1
  done
  echo "sing: sing-box не поднялся, см. $LOG_FILE" >&2
  exit 1
}

# Останавливает фоновый sing-box, запущенный этим скриптом.
stop_sing_box() {
  if [[ -f "$PID_FILE" ]] && kill "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "sing: sing-box остановлен"
  else
    echo "sing: sing-box не запущен"
  fi
  rm -f "$PID_FILE"
}

# Запускает .app-приложение (Electron/Chromium) с флагом --proxy-server:
# Chromium игнорирует HTTPS_PROXY, а proxychains ломает его сетевой процесс.
# Уже открытый экземпляр нужно закрыть, иначе запуск передастся ему без прокси.
launch_app() {
  local app_argument="$1" app_name app_path executable_name
  shift
  if [[ "$app_argument" == */* ]]; then
    # Передан путь (к бандлу или к бинарнику внутри него) — обрезаем до «….app»
    app_path="${app_argument%%.app*}.app"
  else
    app_name="${app_argument%.app}"
    app_path="/Applications/$app_name.app"
    [[ -d "$app_path" ]] || app_path="$HOME/Applications/$app_name.app"
  fi
  if [[ ! -d "$app_path" ]]; then
    echo "sing: не найдено $app_path" >&2
    exit 1
  fi
  app_name="$(basename "$app_path" .app)"
  executable_name="$(defaults read "$app_path/Contents/Info" CFBundleExecutable)"
  if pgrep -xq "$executable_name"; then
    echo "sing: $app_name уже запущен — закрой его (Cmd+Q) и повтори" >&2
    exit 1
  fi
  nohup "$app_path/Contents/MacOS/$executable_name" \
    --proxy-server="http://127.0.0.1:$SOCKS_PORT" \
    --proxy-bypass-list="localhost;127.0.0.1;::1" "$@" >/dev/null 2>&1 &
  echo "sing: $app_name запущен через прокси"
}

# Печатает маршрут до сервера, состояние SOCKS и внешний IP через туннель.
show_status() {
  local server_ip
  server_ip="$(resolve_ipv4 "$(get_server_host)")"
  echo "сервер:   $server_ip via $(route -n get "$server_ip" | awk '/interface:/ { print $2 }')"
  if is_socks_listening; then
    echo "socks:    127.0.0.1:$SOCKS_PORT слушает"
    echo "внешний IP через прокси: $(curl -s --max-time 10 --socks5-hostname 127.0.0.1:$SOCKS_PORT https://ifconfig.me)"
  else
    echo "socks:    не запущен"
  fi
}

case "${1:-}" in
  "")
    sed -n '6,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
  stop)
    stop_sing_box
    ;;
  status)
    show_status
    ;;
  select)
    shift
    case "${1:-}" in
      "" | add | rm | remove)
        python3 -I "$SELECT_SCRIPT" "$@"
        ;;
      *)
        python3 -I "$SELECT_SCRIPT" "$@"
        # Перезапускаем sing-box, только если он был запущен
        if is_socks_listening; then
          stop_sing_box >/dev/null
          sleep 0.3
          ensure_sing_box_running
          echo "sing: sing-box перезапущен"
        fi
        ;;
    esac
    ;;
  app)
    [[ -n "${2:-}" ]] || { echo "sing: укажи приложение, например: sing app Claude" >&2; exit 1; }
    ensure_sing_box_running
    shift
    launch_app "$@"
    ;;
  *)
    ensure_sing_box_running
    # Статические/самодостаточные бинарники (Go, Bun, Node SEA — например claude, gh)
    # proxychains не перехватывает, им прокси передаётся через переменные окружения;
    # sing-box слушает mixed-инбаунд (HTTP + SOCKS5) на одном порту.
    export HTTP_PROXY="http://127.0.0.1:$SOCKS_PORT" HTTPS_PROXY="http://127.0.0.1:$SOCKS_PORT"
    export http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY"
    export ALL_PROXY="socks5h://127.0.0.1:$SOCKS_PORT" all_proxy="socks5h://127.0.0.1:$SOCKS_PORT"
    export NO_PROXY="localhost,127.0.0.1,::1" no_proxy="localhost,127.0.0.1,::1"
    exec proxychains4 -q -f "$PROXYCHAINS_CONFIG" "$@"
    ;;
esac
